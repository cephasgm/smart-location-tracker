{
  "name": "CephasGM Smart Location Tracker",
  "short_name": "SmartTracker",
  "description": "Advanced location tracking PWA with real-time navigation, geofencing, offline support, and AI-powered insights",
  "start_url": "/smart-location-tracker/",
  "scope": "/smart-location-tracker/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "minimal-ui", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#667eea",
  "theme_color": "#667eea",
  "status_bar": "default",
  
  "icons": [
    {
      "src": "/smart-location-tracker/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/smart-location-tracker/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/smart-location-tracker/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/smart-location-tracker/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/smart-location-tracker/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/smart-location-tracker/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/smart-location-tracker/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/smart-location-tracker/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],

  "screenshots": [
    {
      "src": "/smart-location-tracker/screenshots/tracking.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "platform": "wide",
      "label": "Live location tracking with real-time map"
    },
    {
      "src": "/smart-location-tracker/screenshots/navigation.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "platform": "wide",
      "label": "Turn-by-turn navigation with route planning"
    },
    {
      "src": "/smart-location-tracker/screenshots/history.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "platform": "wide",
      "label": "Trip history with playback feature"
    }
  ],

  "shortcuts": [
    {
      "name": "Start Tracking",
      "short_name": "Track",
      "description": "Begin location tracking immediately",
      "url": "/smart-location-tracker/?action=start",
      "icons": [{ "src": "/smart-location-tracker/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "View History",
      "short_name": "History",
      "description": "View your trip history",
      "url": "/smart-location-tracker/?action=history",
      "icons": [{ "src": "/smart-location-tracker/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Profile",
      "short_name": "Profile",
      "description": "View and edit your profile",
      "url": "/smart-location-tracker/?action=profile",
      "icons": [{ "src": "/smart-location-tracker/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Geofences",
      "short_name": "Zones",
      "description": "Manage your geofence zones",
      "url": "/smart-location-tracker/?action=geofences",
      "icons": [{ "src": "/smart-location-tracker/icon-96x96.png", "sizes": "96x96" }]
    }
  ],

  "categories": ["navigation", "travel", "utilities", "productivity"],
  "lang": "en-US",
  "dir": "ltr",
  
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://cephasgm.github.io/smart-location-tracker/manifest.json"
    }
  ],

  "prefer_related_applications": false,

  "permissions": {
    "geolocation": {
      "description": "Required for tracking your location in real-time"
    },
    "notifications": {
      "description": "Used for geofence alerts and navigation prompts"
    }
  },

  "features": {
    "geofencing": true,
    "background_sync": true,
    "periodic_background_sync": true,
    "navigation": true,
    "offline_storage": true,
    "location_history": true,
    "social_sharing": true,
    "analytics": true
  },

  "edge_side_panel": {
    "preferred_width": 480
  },

  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },

  "protocol_handlers": [
    {
      "protocol": "web+location",
      "url": "/smart-location-tracker/?share=%s"
    },
    {
      "protocol": "web+track",
      "url": "/smart-location-tracker/?start=%s"
    }
  ],

  "url_handlers": [
    {
      "origin": "https://cephasgm.github.io"
    }
  ],

  "scope_extensions": [
    {
      "origin": "https://*.cephasgm.github.io"
    }
  ],

  "note_taking": {
    "new_note_url": "/smart-location-tracker/?note=new"
  },

  "file_handlers": {
    "gpx": {
      "name": "GPX Track File",
      "accept": {
        "application/gpx+xml": [".gpx"]
      },
      "launch_type": "single-client"
    },
    "kml": {
      "name": "KML Location File",
      "accept": {
        "application/vnd.google-earth.kml+xml": [".kml"]
      },
      "launch_type": "single-client"
    }
  },

  "share_target": {
    "action": "/smart-location-tracker/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link",
      "files": [
        {
          "name": "location",
          "accept": ["application/gpx+xml", "application/vnd.google-earth.kml+xml"]
        }
      ]
    }
  },

  "window_controls_overlay": true,

  "handle_links": "preferred",
  "prefer_related_applications": false,

  "splash_pages": {
    "fallback": "/smart-location-tracker/splash.html"
  },

  "iarc_rating_id": "e0e5b4a3-8f7c-4d2b-9a6f-1c3d8e5b7a2c",

  "display_overrides": {
    "window-controls-overlay": {
      "title": {
        "default": "Smart Location Tracker"
      }
    }
  },

  "background_color_secondary": "#764ba2",

  "description_markdown": "**Smart Location Tracker** is a professional-grade PWA that provides:\n\n" +
    "• Real-time GPS tracking with high accuracy\n" +
    "• Turn-by-turn navigation with voice guidance\n" +
    "• Geofencing with custom zones and alerts\n" +
    "• Complete offline support with automatic sync\n" +
    "• Trip history with playback feature\n" +
    "• Share locations via multiple platforms\n" +
    "• Battery-optimized tracking\n" +
    "• GDPR compliant with user consent\n\n" +
    "Perfect for fleet management, personal tracking, and navigation needs.",

  "keywords": [
    "GPS tracking",
    "location sharing",
    "navigation",
    "geofencing",
    "offline maps",
    "trip history",
    "real-time tracking",
    "PWA",
    "fleet management",
    "personal tracker"
  ],

  "author": {
    "name": "CephasGM",
    "website": "https://github.com/cephasgm"
  },

  "version": "3.0.0",
  "version_name": "3.0.0 (Professional Edition)",

  "minimum_chrome_version": "88",
  "minimum_firefox_version": "90",
  "minimum_edge_version": "90",
  "minimum_safari_version": "15",

  "capabilities": {
    "geolocation": {
      "permission": "required",
      "note": "Core functionality requires location access"
    },
    "notifications": {
      "permission": "optional",
      "note": "Used for alerts and navigation prompts"
    },
    "background_fetch": {
      "permission": "optional",
      "note": "Enables offline data sync"
    },
    "background_sync": {
      "permission": "optional",
      "note": "Syncs location data when online"
    },
    "periodic_background_sync": {
      "permission": "optional",
      "note": "Updates geofences periodically"
    }
  },

  "serviceworker": {
    "src": "/smart-location-tracker/service-worker.js",
    "scope": "/smart-location-tracker/",
    "use_cache": true,
    "cache_name": "smart-tracker-v3",
    "strategy": "stale-while-revalidate",
    "offline_page": "/smart-location-tracker/offline.html"
  },

  "offline_enabled": true,
  "offline_capabilities": [
    "location tracking",
    "geofence monitoring",
    "trip recording",
    "map caching"
  ],

  "orientation_lock": {
    "default": "portrait-primary",
    "map": "any",
    "navigation": "landscape"
  },

  "notifications": {
    "icon": "/smart-location-tracker/icon-192x192.png",
    "badge": "/smart-location-tracker/icon-72x72.png",
    "vibrate": [200, 100, 200],
    "sound": "/smart-location-tracker/notification.mp3"
  },

  "analytics": {
    "firebase": true,
    "sentry": true,
    "privacy_compliant": true
  },

  "privacy_policy": "https://cephasgm.github.io/smart-location-tracker/privacy.html",
  "terms_of_service": "https://cephasgm.github.io/smart-location-tracker/terms.html",

  "support": {
    "email": "support@smarttracker.com",
    "website": "https://github.com/cephasgm/smart-location-tracker/issues",
    "phone": "+1234567890"
  },

  "release_notes": {
    "3.0.0": "Added navigation engine, location history playback, social sharing, user profiles, analytics, performance optimization"
  },

  "debug": {
    "enabled": false,
    "log_level": "error"
  },

  "environment": "production"
}
