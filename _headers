# _headers file for GitHub Pages
/smart-location-tracker/*
  Service-Worker-Allowed: /smart-location-tracker/
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type

/smart-location-tracker/service-worker.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /smart-location-tracker/

/smart-location-tracker/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: max-age=3600

/smart-location-tracker/*.html
  Cache-Control: no-cache

/smart-location-tracker/*.css
  Cache-Control: max-age=3600

/smart-location-tracker/*.js
  Cache-Control: max-age=3600

/smart-location-tracker/*.png
  Cache-Control: max-age=86400

/smart-location-tracker/*.jpg
  Cache-Control: max-age=86400

/smart-location-tracker/*.svg
  Cache-Control: max-age=86400

/smart-location-tracker/*.ico
  Cache-Control: max-age=86400

# Security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
